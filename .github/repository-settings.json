{
  "schema_version": "1.0",
  "repository": "snapsynapse/hardguard25",
  "profile": [
    "public-open-spec",
    "multi-runtime-package",
    "github-pages",
    "maintenance-only"
  ],
  "visibility": "public",
  "default_branch": "main",
  "delete_branch_on_merge": true,
  "merge_methods": {
    "merge_commit": true,
    "squash": true,
    "rebase": true,
    "auto_merge": false
  },
  "features": {
    "issues": true,
    "discussions": true,
    "wiki": false,
    "projects": false
  },
  "security": {
    "advanced_security": null,
    "secret_scanning": true,
    "secret_scanning_push_protection": true,
    "dependabot_alerts": true,
    "dependabot_security_updates": true
  },
  "actions": {
    "enabled": true,
    "allowed_actions": "all",
    "sha_pinning_required": false,
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "pages": {
    "enabled": true,
    "build_type": "workflow",
    "artifact_path": "docs",
    "cname": "hardguard25.com",
    "https_enforced": true
  },
  "rulesets": [
    {
      "name": "Protect the default maintenance branch",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "exclude": [],
          "include": [
            "~DEFAULT_BRANCH"
          ]
        }
      },
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        }
      ]
    }
  ],
  "environments": [
    {
      "name": "github-pages",
      "deployment_branch": "main"
    },
    {
      "name": "pypi",
      "deployment_branch": "all refs; release workflow itself is tag-only"
    }
  ],
  "custom_properties": {},
  "exceptions": [
    {
      "field": "security.advanced_security",
      "reason": "The public repository API does not expose a separately configurable repository value; keep the desired state unknown rather than inferring disabled or enabled.",
      "date": "2026-10-03"
    },
    {
      "field": "custom_properties",
      "reason": "Organization custom properties are unsupported for this user-owned repository.",
      "date": "2026-10-03"
    },
    {
      "field": "rulesets.Protect the default maintenance branch",
      "reason": "Prevent branch deletion and history rewrites while preserving the repository's direct fast-forward maintenance and release workflow.",
      "date": "2026-10-03"
    }
  ]
}
